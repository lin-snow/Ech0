{
  "name": "@useech0/cli",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Ech0 command line client for accessing and managing your Ech0 instance.",
  "bin": {
    "ech0": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "gen:api": "openapi-ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "dist": "bun run scripts/dist.ts"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/bun": "^1.4.4",
    "typescript": "5.9"
  }
}
