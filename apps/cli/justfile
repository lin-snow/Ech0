# Ech0 CLI (Bun + TypeScript, talks to a running instance over the REST API)

default:
    @just --list

dev:
    bun run src/index.ts

help:
    bun run src/index.ts --help

# Regenerate src/api from internal/openapi/openapi.yaml (Huma spec = SSOT)
gen:
    bun run gen:api

gen-check: gen
    git diff --exit-code -- src/api/generated

build:
    bun run build

# Release artifacts: standalone binaries, release tarballs, SHA256SUMS, and
# publishable npm packages under dist/release. Version is the CLI release tag
# without the `cli-v` prefix (e.g. `just cli dist 0.1.0`).
dist VERSION:
    bun run scripts/dist.ts --version {{VERSION}} --out dist/release

# Bump apps/cli/package.json to NEW_VERSION after a clean-tree check and
# typecheck; prints the commit/tag/push steps for a manual release.
bump NEW_VERSION:
    bun run scripts/release.ts bump {{NEW_VERSION}}

# Cut a CLI release end to end: check, bump, commit, tag cli-vX.Y.Z and push.
# The tag starts release-cli.yml; set ECH0_CLI_DRY=1 to stop after the checks.
release NEW_VERSION:
    #!/usr/bin/env bash
    set -euo pipefail
    args=(release "{{NEW_VERSION}}")
    if [[ "${ECH0_CLI_DRY:-}" == "1" ]]; then
        args+=(--dry-run)
    fi
    bun run scripts/release.ts "${args[@]}"

typecheck:
    bun run typecheck

test:
    bun test

check: typecheck test gen-check
