# Sample values for the Vercel port. Set secrets only in the deployment environment.
ECH0_DB_TYPE=libsql
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
JWT_SECRET=
CRON_SECRET=
ECH0_SETTING_SERVER_URL=
ECH0_AUTH_WEBAUTHN_RP_ID=
ECH0_AUTH_WEBAUTHN_ORIGINS=

ECH0_OBJECT_ENABLED=true
ECH0_S3_PROVIDER=r2
ECH0_S3_REGION=auto
ECH0_S3_BUCKET=
ECH0_S3_ENDPOINT=
ECH0_S3_ACCESS_KEY=
ECH0_S3_SECRET_KEY=
ECH0_S3_USE_SSL=true
ECH0_S3_USE_PATH_STYLE=true
ECH0_UPLOAD_VERIFIED_DIRECT=true
ECH0_LOG_FILE_ENABLE=false
ECH0_STORAGE_DATA_ROOT=/tmp/ech0-files
