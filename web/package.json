{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "lin-snow",
  "homepage": "https://github.com/lin-snow/Ech0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "token:check": "node ./scripts/check-token-usage.mjs",
    "i18n:key-check": "node ./scripts/check-i18n-keys.mjs",
    "i18n:unused-check": "node ./scripts/check-i18n-unused.mjs",
    "i18n:hardcoded-check": "node ./scripts/check-i18n-hardcoded.mjs",
    "i18n:pseudo-smoke": "node ./scripts/pseudo-locale-smoke.mjs",
    "i18n:check": "pnpm run i18n:key-check && pnpm run i18n:unused-check && pnpm run i18n:hardcoded-check && pnpm run i18n:pseudo-smoke",
    "test:unit": "vitest run",
    "lint": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{vue,css,scss}\" --fix --cache",
    "lint:style:check": "stylelint \"src/**/*.{vue,css,scss}\" --cache",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@cap.js/widget": "^0.1.58",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@headlessui/vue": "^1.7.23",
    "@tanstack/vue-virtual": "^3.13.48",
    "@vueuse/core": "^15.0.0",
    "floating-vue": "^5.4.0",
    "highlight.js": "^11.12.0",
    "leaflet": "^1.9.4",
    "markdown-it": "^15.0.3",
    "ofetch": "^1.5.1",
    "photoswipe": "^5.4.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "vue-virtual-scroller": "3.0.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@unocss/preset-wind4": "66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "3.9.10",
    "sass-embedded": "^1.107.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unocss": "66.12.0",
    "vite": "^8.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.16.1"
}
